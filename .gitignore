.claude/
.cursor/
.codex/

# Scratch / one-shot test scripts
.tmp-*

# Forge dogfooding
# Spec files (spec/*.md, plans/phases.yaml) are tracked in git — they're the shared
# source of truth across maintainers (team-mode-minimum-architecture.md 2026-05-17).
# They're excluded from the published npm tarball via package.json#files allowlist
# (verified by a CI npm-pack gate). DO NOT re-add spec files here.
/plans/tasks/*.plan.md
/plans/tasks/*.investigation.md
# docs/learnings/ is TRACKED so compound learnings travel between machines/clones
# (a fresh clone reproduces the origin machine's accumulated context). Excluded
# from the published npm tarball via package.json#files allowlist + the CI
# npm-pack gate (docs/ is a FORBIDDEN_PREFIX). DO NOT re-add it here.

# >>> forge-managed (do not edit between markers) >>>
/.forge/*
!/.forge/settings.yaml
/.forge.eject-backup-*/
/.claude/skills/
/.claude/agents/
/.codex/skills/
/.codex/agents/
/.gemini/skills/
/.gemini/agents/
/.agents/skills/
/.cursor/agents/
/.cursor/rules/forge-context.mdc
# <<< forge-managed <<<
