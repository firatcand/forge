# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Backups (created by setup.sh when conflicts exist)
*.bak

# Node (in case examples grow)
node_modules/
*.log
npm-debug.log*

# Env
.env
.env.local
.env.production

# Build artifacts
dist/
build/
.next/

# Test artifacts
coverage/
.nyc_output/

# Local dev
.cache/
tmp/

# AI tool local state (project-scoped Claude Code, etc.)
.claude/
.cursor/
.codex/

# Scratch / one-shot test scripts
.tmp-*

# Forge dogfooding
# Spec files (spec/*.md, plans/phases.yaml) are tracked in git — they're the shared
# source of truth across maintainers (team-mode-minimum-architecture.md 2026-05-17).
# They're excluded from the published npm tarball via package.json#files allowlist
# (verified by a CI npm-pack gate). DO NOT re-add spec files here.
/plans/tasks/*.plan.md
/docs/learnings/**
/.forge/
