# Template for .env.local — copy to .env.local and fill in.
# .env.local is gitignored; this file is committed as a reference.
# Referenced by .forge/settings.yaml -> secrets.env_file_path

# Linear E2E integration tests (test/integration/trackers/linear.test.ts)
# Set FORGE_E2E_LINEAR=1 to enable. Use a THROWAWAY team — tests create issues/projects/labels.
# FORGE_E2E_LINEAR=1
# FORGE_E2E_LINEAR_TEAM_ID=
# LINEAR_API_KEY=lin_api_

# GitHub E2E
# FORGE_E2E_GITHUB=1
# FORGE_E2E_REPO=owner/repo

# Notion E2E
# FORGE_E2E_NOTION=1
# FORGE_E2E_NOTION_DATABASE_ID=
# NOTION_TOKEN=secret_
