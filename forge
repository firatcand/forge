#!/usr/bin/env bash
set -euo pipefail

# Forge CLI — initialize a forge project

FORGE_DIR="$(dirname "$(readlink -f "$0" 2>/dev/null || readlink "$0" || echo "$0")")"

# If forge is symlinked from ~/.local/bin/, resolve to actual repo
if [[ -L "$0" ]]; then
  ACTUAL_PATH=$(readlink "$0")
  if [[ "${ACTUAL_PATH}" != /* ]]; then
    ACTUAL_PATH="$(dirname "$0")/${ACTUAL_PATH}"
  fi
  FORGE_DIR=$(dirname "${ACTUAL_PATH}")
fi

TEMPLATES_DIR="${FORGE_DIR}/templates"

usage() {
  cat <<EOF
🔨 forge — Lightweight Claude Code framework

Usage:
  forge init                    Initialize a forge project in the current directory
  forge templates list          List available templates
  forge templates copy NAME     Copy a specific template
  forge upgrade                 Pull latest forge from upstream
  forge version                 Show forge version

Skills (use inside Claude Code):
  /forge          Socratic ideation → BRIEF.md
  /draft-prd      Generate PRD.md from BRIEF.md
  /draft-spec     Generate SPEC.md from PRD.md
  /draft-design   Generate DESIGN.md from PRD.md (optional)
  /ingest-spec    Validate spec docs
  /decompose      spec → phases.yaml
  /setup-repo     GitHub repo + workflows + branch protection
  /push-to-linear Linear project + cycles + issues
  /pickup-task    Claim next task, create worktree
  /plan-task      Plan mode for task
  /implement      Execute plan
  /review         Multi-agent review
  /qa             Tests + browser checks
  /codex          Second-opinion review via Codex CLI
  /ship           Push branch, open PR
  /learn          Capture learning
  /phase-gate     Advance phase ceremony
  /retro          Phase retrospective

EOF
}

cmd_init() {
  if [[ -f "CLAUDE.md" ]]; then
    echo "⚠️  CLAUDE.md already exists. Overwrite? [y/N]"
    read -r answer
    [[ "${answer}" != "y" ]] && exit 1
  fi

  echo "🔨 Initializing forge project..."

  # Create directory structure
  mkdir -p spec plans/tasks docs/{learnings,retros} .claude/commands

  # Copy templates
  cp "${TEMPLATES_DIR}/CLAUDE.project.template.md" CLAUDE.md
  cp "${TEMPLATES_DIR}/CRITICAL.template.md" CRITICAL.md

  # Create .env.example placeholder
  if [[ ! -f ".env.example" ]]; then
    cat > .env.example <<EOF
# Environment variables — fill in based on spec/SPEC.md
# Copy to .env (which is gitignored) for local development

# Example:
# DATABASE_URL=
# API_KEY=
EOF
  fi

  # Update .gitignore
  if [[ ! -f ".gitignore" ]]; then
    touch .gitignore
  fi

  if ! grep -q "^.env$" .gitignore; then
    cat >> .gitignore <<EOF

# Forge defaults
.env
.env.local
.env.production
node_modules/
*.log
.DS_Store
EOF
  fi

  # Project name from current directory
  project_name=$(basename "$(pwd)")

  # Substitute project name in CLAUDE.md
  sed -i.bak "s/{{PROJECT_NAME}}/${project_name}/g" CLAUDE.md && rm CLAUDE.md.bak

  echo "✅ Forge project initialized"
  echo ""
  echo "Created:"
  echo "  📁 spec/        — PRD, SPEC, DESIGN go here"
  echo "  📁 plans/       — phases.yaml + per-task plans"
  echo "  📁 docs/        — learnings + retros"
  echo "  📄 CLAUDE.md    — project rules for Claude Code"
  echo "  📄 CRITICAL.md  — paths requiring multi-model review"
  echo "  📄 .env.example — environment variables template"
  echo ""
  echo "Next: open Claude Code and run /forge"
}

cmd_templates_list() {
  echo "Available templates in ${TEMPLATES_DIR}:"
  ls -1 "${TEMPLATES_DIR}"
}

cmd_templates_copy() {
  local name="${1:-}"
  if [[ -z "${name}" ]]; then
    echo "Usage: forge templates copy NAME"
    echo ""
    cmd_templates_list
    exit 1
  fi

  local src="${TEMPLATES_DIR}/${name}"
  if [[ ! -e "${src}" ]]; then
    echo "❌ Template not found: ${name}"
    cmd_templates_list
    exit 1
  fi

  cp -r "${src}" .
  echo "✅ Copied ${name} → $(pwd)/${name}"
}

cmd_upgrade() {
  cd "${FORGE_DIR}"
  echo "🔄 Updating forge from upstream..."
  git pull --ff-only
  echo "✅ Forge updated"
}

cmd_version() {
  cd "${FORGE_DIR}"
  echo "forge $(git describe --tags --always 2>/dev/null || echo 'unknown')"
}

# Dispatch
case "${1:-}" in
  init)              cmd_init ;;
  templates)
    case "${2:-}" in
      list)          cmd_templates_list ;;
      copy)          cmd_templates_copy "${3:-}" ;;
      *)             echo "Usage: forge templates {list|copy NAME}"; exit 1 ;;
    esac ;;
  upgrade)           cmd_upgrade ;;
  version)           cmd_version ;;
  -h|--help|help|"") usage ;;
  *)                 echo "Unknown command: $1"; usage; exit 1 ;;
esac
