{
  "name": "@firatcand/forge",
  "version": "0.4.4",
  "description": "A lightweight framework for shipping software products from idea to production with AI coding agents (Claude Code, Codex CLI, Cursor, Gemini)",
  "type": "module",
  "bin": {
    "forge": "dist/bin/forge.cjs",
    "forge-sync-status-render": "dist/bin/sync-status-render.cjs"
  },
  "files": [
    "dist/",
    "skills/",
    "agents/",
    "templates/",
    "vendor/",
    "ETHOS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "test:pack": "node scripts/test-pack.mjs",
    "lint:test-helpers": "node scripts/lint-test-helpers.mjs",
    "forge:render-context": "node --import tsx scripts/forge-render-context.mjs",
    "dev": "tsx watch src/bin/forge.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@linear/sdk": "^84.0.0",
    "chalk": "^5.3.0",
    "execa": "^9.5.0",
    "uuid": "^10.0.0",
    "web-tree-sitter": "0.22.6",
    "yaml": "^2.8.4",
    "zod": "^3.25.76"
  },
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "cursor",
    "gemini",
    "ai-agent",
    "agentic-coding",
    "framework",
    "skills",
    "subagents",
    "compound-engineering",
    "product-development",
    "linear",
    "github"
  ],
  "author": "Firat Can Basarir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firatcand/forge.git"
  },
  "homepage": "https://github.com/firatcand/forge#readme",
  "bugs": {
    "url": "https://github.com/firatcand/forge/issues"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.4.1",
    "tree-sitter-wasms": "0.1.13",
    "tsdown": "0.22.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
