{
  "name": "@firatcand/forge",
  "version": "0.2.1",
  "description": "A lightweight framework for shipping software products from idea to production with AI coding agents (Claude Code, Codex CLI, Cursor, Gemini)",
  "type": "module",
  "bin": {
    "forge": "bin/forge.js"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "agents/",
    "templates/",
    "dist/",
    "ETHOS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "dev": "tsx watch src/bin/forge.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "execa": "^9.5.0",
    "fs-extra": "^11.2.0",
    "yaml": "^2.8.4",
    "zod": "^3.25.76"
  },
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "cursor",
    "gemini",
    "ai-agent",
    "agentic-coding",
    "framework",
    "skills",
    "subagents",
    "compound-engineering",
    "product-development",
    "linear",
    "github"
  ],
  "author": "Firat Can Basarir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firatcand/forge.git"
  },
  "homepage": "https://github.com/firatcand/forge#readme",
  "bugs": {
    "url": "https://github.com/firatcand/forge/issues"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "tsdown": "0.22.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
